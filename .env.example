# Copy to .env.local and fill in. Vite exposes only VITE_* vars to the browser.
# Firebase web config: Firebase console > Project settings > Your apps.
# (These identify your project; they are not secrets. Security comes from Firestore/Storage rules.)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Drive (optional): README → Google Drive explains where each comes from.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=

# Server-only (never sent to the browser)
# Free key from https://openalex.org/settings/api raises the shared daily search budget.
OPENALEX_API_KEY=
# Optional contact address for Crossref's "polite" pool (faster, more reliable).
CROSSREF_MAILTO=
# API port (5000 is taken by AirPlay Receiver on macOS)
API_PORT=5050
